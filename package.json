{
  "name": "decanti",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:mobile": "node scripts/check-env.mjs && tsc -b && vite build --mode mobile",
    "icons:app": "node scripts/generate-app-icons.mjs",
    "cap:sync": "npm run build:mobile && npx cap sync && node scripts/configure-deeplinks.mjs",
