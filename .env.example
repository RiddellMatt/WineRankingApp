VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Edge Function secrets (Supabase Dashboard → Edge Functions → Secrets) ──

# AI menu scan
# GEMINI_API_KEY=your-google-ai-studio-key
# PRO_UNLOCK_CODES=promo-code-one,promo-code-two  (optional support codes; not in client)
# GEMINI_MODEL=gemini-3.7-flash

# Stripe subscriptions (Sprint 1)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...          # recurring price for Cellar Rank Pro
# APP_URL=https://riddellmatt.github.io/WineRankingApp/
# STRIPE_SUCCESS_URL=               # optional; defaults to APP_URL/?checkout=success
# STRIPE_CANCEL_URL=                # optional; defaults to APP_URL/?checkout=cancel
# STRIPE_PORTAL_RETURN_URL=         # optional; defaults to APP_URL/?view=account

# Deploy Edge Functions:
#   supabase functions deploy create-pro-checkout
#   supabase functions deploy create-billing-portal
#   supabase functions deploy stripe-webhook
#   supabase functions deploy scan-menu redeem-pro
#
# Stripe webhook URL:
#   https://YOUR_PROJECT_REF.supabase.co/functions/v1/stripe-webhook
#
# Listen for events: checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted, invoice.payment_failed
