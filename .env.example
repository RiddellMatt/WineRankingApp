VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Supabase Auth: Google + Apple (Dashboard → Authentication) ──
#
# URL Configuration (Authentication → URL Configuration):
#   Site URL: https://riddellmatt.github.io/WineRankingApp/
#   Redirect URLs:
#     https://riddellmatt.github.io/WineRankingApp/
#     http://localhost:5173/
#
# Google provider:
#   1. Google Cloud Console → OAuth client (Web application)
#   2. Authorized redirect URI: https://YOUR_PROJECT_REF.supabase.co/auth/v1/callback
#   3. Paste Client ID + Secret into Supabase → Authentication → Providers → Google
#
# Apple provider:
#   1. Apple Developer → Identifiers → Services ID + Sign in with Apple key
#   2. Return URL: https://YOUR_PROJECT_REF.supabase.co/auth/v1/callback
#   3. Paste Services ID, Team ID, Key ID, and private key (.p8) in Supabase → Apple
#
# After enabling providers, run section 5 in supabase/run-in-sql-editor.sql
# so OAuth display names and Google avatars seed profiles on first sign-in.
#
# Mobile app redirect URL (Decanti — add to Redirect URLs list):
#   com.northline.decanti://login-callback
#
# Legacy Cellar Rank builds used com.northline.cellarrank://login-callback — keep
# that URL registered until all testers have updated.

# ── Edge Function secrets (Supabase Dashboard → Edge Functions → Secrets) ──

# AI menu scan
# GEMINI_API_KEY=your-google-ai-studio-key
# PRO_UNLOCK_CODES=promo-code-one,promo-code-two  (optional support codes; not in client)
# GEMINI_MODEL=gemini-3.7-flash

# Stripe subscriptions (Sprint 1)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...          # recurring price for Decanti Pro
# APP_URL=https://riddellmatt.github.io/WineRankingApp/
# STRIPE_SUCCESS_URL=               # optional; defaults to APP_URL/?checkout=success
# STRIPE_CANCEL_URL=                # optional; defaults to APP_URL/?checkout=cancel
# MOBILE_APP_SCHEME=com.northline.decanti
# MOBILE_STRIPE_SUCCESS_URL=com.northline.decanti://checkout-success
# MOBILE_STRIPE_CANCEL_URL=com.northline.decanti://checkout-cancel
# MOBILE_STRIPE_PORTAL_RETURN_URL=com.northline.decanti://account

# iOS In-App Purchase (RevenueCat) — see mobile/REVENUECAT_SETUP.md
# VITE_REVENUECAT_IOS_API_KEY=appl_...       # Public Apple SDK key (Codemagic decanti_env)
# VITE_REVENUECAT_ENTITLEMENT_ID=pro         # Optional; must match RevenueCat entitlement
# REVENUECAT_SECRET_API_KEY=sk_...           # Supabase Edge Function secret only
# REVENUECAT_WEBHOOK_AUTHORIZATION=Bearer ... # Same value as RevenueCat webhook auth header
# REVENUECAT_ENTITLEMENT_ID=pro              # Optional server default

# Deploy Edge Functions:
#   supabase functions deploy create-pro-checkout
#   supabase functions deploy create-billing-portal
#   supabase functions deploy stripe-webhook
#   supabase functions deploy scan-menu scan-label redeem-pro
#   supabase functions deploy sync-revenuecat-entitlement revenuecat-webhook
#
# Stripe webhook URL:
#   https://YOUR_PROJECT_REF.supabase.co/functions/v1/stripe-webhook
#
# Listen for events: checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted, invoice.payment_failed
